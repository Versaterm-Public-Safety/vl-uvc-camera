#!/usr/bin/env bash
set -e

# Generic pre-commit hook that detects and runs available linters.
# Installed by running: ./scripts/install-hooks.sh

echo "Running pre-commit checks..."

# Track if any check fails
FAILED=0

# --- Python linting ---
# Exclude plugin-managed Claude files (.claude/) from linting
if git diff --cached --name-only | grep '\.py$' | grep -qv '^\.claude/'; then
    echo ""
    echo "=== Python files detected ==="

    if command -v ruff >/dev/null 2>&1 || command -v uv >/dev/null 2>&1; then
        echo "Running ruff..."
        if command -v uv >/dev/null 2>&1; then
            uv run ruff check --exclude .claude . || FAILED=1
        else
            ruff check --exclude .claude . || FAILED=1
        fi
    fi

    if command -v mypy >/dev/null 2>&1 || command -v uv >/dev/null 2>&1; then
        echo "Running mypy..."
        if command -v uv >/dev/null 2>&1; then
            uv run mypy . --ignore-missing-imports --exclude '^\.claude/' || FAILED=1
        else
            mypy . --ignore-missing-imports --exclude '^\.claude/' || FAILED=1
        fi
    fi
fi

# --- JavaScript/TypeScript linting ---
if git diff --cached --name-only | grep -qE '\.(js|jsx|ts|tsx)$'; then
    echo ""
    echo "=== JS/TS files detected ==="

    if [ -f "package.json" ]; then
        if command -v npx >/dev/null 2>&1; then
            # Check if eslint is configured
            if npx eslint --print-config . >/dev/null 2>&1; then
                echo "Running eslint..."
                npx eslint . || FAILED=1
            fi

            # Check if TypeScript is configured
            if [ -f "tsconfig.json" ]; then
                echo "Running tsc..."
                npx tsc --noEmit || FAILED=1
            fi
        fi
    fi
fi

# --- Go linting ---
if git diff --cached --name-only | grep -q '\.go$'; then
    echo ""
    echo "=== Go files detected ==="

    if command -v golangci-lint >/dev/null 2>&1; then
        echo "Running golangci-lint..."
        golangci-lint run || FAILED=1
    elif command -v go >/dev/null 2>&1; then
        echo "Running go vet..."
        go vet ./... || FAILED=1
    fi
fi

# --- Rust linting ---
if git diff --cached --name-only | grep -q '\.rs$'; then
    echo ""
    echo "=== Rust files detected ==="

    if command -v cargo >/dev/null 2>&1; then
        echo "Running cargo clippy..."
        cargo clippy -- -D warnings || FAILED=1
    fi
fi

if [ $FAILED -ne 0 ]; then
    echo ""
    echo "Pre-commit checks FAILED. Fix the issues above before committing."
    exit 1
fi

echo ""
echo "All pre-commit checks passed."
exit 0
